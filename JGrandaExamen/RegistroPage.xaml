<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JGrandaExamen.RegistroPage"
             Title="Registro">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label x:Name="lblUsuario" HorizontalOptions="End" />

            <Label Text="REGISTRO" Style="{StaticResource EstiloTitulo}" />

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10">
                <Label Text="Fecha" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" />
                <DatePicker x:Name="dpFecha" Grid.Row="0" Grid.Column="1" />

                <Label Text="País" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" />
                <Picker x:Name="pickerPais" Title="Paises" Grid.Row="1" Grid.Column="1"
                        SelectedIndexChanged="PickerPais_SelectedIndexChanged" />

                <Label Text="Ciudad" Grid.Row="2" Grid.Column="0" VerticalOptions="Center" />
                <Picker x:Name="pickerCiudad" Title="Ciudades" Grid.Row="2" Grid.Column="1" />

                <Label Text="Monto Inicial" Grid.Row="3" Grid.Column="0" VerticalOptions="Center" />
                <Entry x:Name="txtMonto" Placeholder="Ingrese el monto inicial" Keyboard="Numeric"
                       Grid.Row="3" Grid.Column="1" />

                <Button Text="Calcular Pago mensual" Style="{StaticResource EstiloBoton}"
                        Grid.Row="4" Grid.Column="0" Clicked="BtnCalcular_Clicked" />
                <Entry x:Name="txtPagoMensual" IsReadOnly="True" Grid.Row="4" Grid.Column="1" />
            </Grid>

            <Label Text="-------------------------------------------------" />

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" ColumnSpacing="5">
                <Label Text="Nombre" Grid.Row="0" Grid.Column="0" />
                <Label Text="Apellido" Grid.Row="0" Grid.Column="1" />
                <Label Text="Edad" Grid.Row="0" Grid.Column="2" />

                <Entry x:Name="txtNombre" Placeholder="Nombre" Grid.Row="1" Grid.Column="0" />
                <Entry x:Name="txtApellido" Placeholder="Apellido" Grid.Row="1" Grid.Column="1" />
                <Entry x:Name="txtEdad" Placeholder="Edad" Keyboard="Numeric" Grid.Row="1" Grid.Column="2" />
            </Grid>

            <Button Text="Ver resumen" Style="{StaticResource EstiloBoton}" Clicked="BtnResumen_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>