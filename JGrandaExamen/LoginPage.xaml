<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JGrandaExamen.LoginPage"
             Title="Instituto Superior Tecnologico Sudamericano">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Image Source="logo.png" HeightRequest="100" />

        <Label Text=" Sudamericano" TextColor="Red" Style="{StaticResource EstiloTitulo}" />

        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10">
            <Label Text="Usuario" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" />
            <Entry x:Name="txtUsuario" Placeholder="Ingrese usuario" Grid.Row="0" Grid.Column="1" />

            <Label Text="Contraseña" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" />
            <Entry x:Name="txtClave" Placeholder="Ingrese contraseña" IsPassword="True" Grid.Row="1" Grid.Column="1" />
        </Grid>

        <Button Text="Iniciar sesión" Style="{StaticResource EstiloBoton}" Clicked="BtnIniciar_Clicked" />

    </VerticalStackLayout>
</ContentPage>